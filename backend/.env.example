# --- App ---
APP_NAME=CTF Insight AI
ENVIRONMENT=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Database (Supabase Postgres in prod, local Postgres in dev) ---
DATABASE_URL=postgresql+asyncpg://ctf_user:ctf_password@localhost:5432/ctf_insight_ai
DATABASE_URL_SYNC=postgresql+psycopg2://ctf_user:ctf_password@localhost:5432/ctf_insight_ai

# --- Redis (cache + job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT (custom, hand-rolled per decision #14) ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=90

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=writeups

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=CTF Insight AI <noreply@ctfinsight.ai>

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# --- AI Providers ---
AI_DEFAULT_PROVIDER=openai        # openai | ollama
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=md,pdf,txt,docx

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_DEFAULT_PER_MINUTE=60
